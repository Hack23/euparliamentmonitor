{
  "mcpServers": {
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/insiders",
      "headers": {
        "Authorization": "Bearer ${{ secrets.COPILOT_MCP_GITHUB_PERSONAL_ACCESS_TOKEN }}",
        "X-MCP-Toolsets": "all"
      },
      "tools": ["*"]
    },
    "filesystem": {
      "type": "local",
      "command": "mcp-server-filesystem",
      "args": [
        "/home/runner/work/euparliamentmonitor/euparliamentmonitor"
      ],
      "tools": ["*"]
    },
    "memory": {
      "type": "local",
      "command": "mcp-server-memory",
      "args": [],
      "tools": ["*"]
    },
    "sequential-thinking": {
      "type": "local",
      "command": "mcp-server-sequential-thinking",
      "args": [],
      "tools": ["*"]
    },
    "playwright": {
      "type": "local",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--headless"
      ],
      "env": {
        "DISPLAY": ":99"
      },
      "tools": ["*"]
    },
    "european-parliament": {
      "type": "local",
      "command": "npx",
      "args": [
        "-y",
        "european-parliament-mcp-server@1.2.19",
        "--timeout",
        "90000"
      ],
      "env": {
        "EP_REQUEST_TIMEOUT_MS": "90000"
      },
      "tools": ["*"]
    },
    "world-bank": {
      "type": "local",
      "command": "npx",
      "args": [
        "-y",
        "worldbank-mcp@1.0.1"
      ],
      "tools": ["*"]
    }
  }
}
