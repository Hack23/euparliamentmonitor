      "purpose": "any"
    },
    {
      "src": "images/favicon-512x512.webp",
      "sizes": "512x512",
      "type": "image/webp",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Latest News",
      "short_name": "News",
      "description": "Browse the most recent EU Parliament news analyses",
      "url": "/index.html",
      "icons": [{ "src": "images/favicon-192x192.png", "sizes": "192x192" }]
    },
    {
      "name": "Sitemap",
      "short_name": "Sitemap",
      "description": "Full directory of every published article and report",
      "url": "/sitemap.html",
      "icons": [{ "src": "images/favicon-192x192.png", "sizes": "192x192" }]
    },
    {
      "name": "Political Intelligence",
      "short_name": "Intel",
      "description": "Daily political intelligence runs and methodology",
      "url": "/political-intelligence.html",
      "icons": [{ "src": "images/favicon-192x192.png", "sizes": "192x192" }]
    }
  ]
}
