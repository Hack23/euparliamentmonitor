{
  "name": "EU Parliament Monitor",
  "short_name": "EU Monitor",
  "description": "European Parliament Intelligence Platform — monitoring political activity with systematic transparency",
  "id": "/?source=pwa",
  "start_url": "/?source=pwa",
  "scope": "/",
  "lang": "en",
  "dir": "ltr",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "minimal-ui", "standalone", "browser"],
  "orientation": "any",
  "background_color": "#003399",
  "theme_color": "#003399",
  "prefer_related_applications": false,
  "categories": ["news", "politics", "government", "education"],
  "launch_handler": { "client_mode": "auto" },
  "icons": [
    {
      "src": "images/favicon-48x48.png",
      "sizes": "48x48",
      "type": "image/png",
      "purpose": "any"
    },
